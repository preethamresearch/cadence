# ── Gemini Live ────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ── SigNoz: writing telemetry (OTLP ingest) ────────────────────
# From SigNoz Cloud -> Settings -> Ingestion. Region is us | eu | in.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
SIGNOZ_INGESTION_KEY=
OTEL_SERVICE_NAME=cadence-voice-agent

# ── SigNoz: reading telemetry back (query API) ─────────────────
# Powers the agent's self-observation tools. Settings -> API Keys.
SIGNOZ_REGION=us
SIGNOZ_API_KEY=

# ── Options ────────────────────────────────────────────────────
# Record transcripts as span attributes. Off by default: utterance text is
# user content, and the GenAI conventions treat content capture as opt-in.
CADENCE_CAPTURE_CONTENT=false
LOG_LEVEL=INFO
